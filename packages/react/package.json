{
  "name": "@jinx-ui/react",
  "version": "0.1.0",
  "description": "React runtime for Jinx UI: 40 components and 3 hooks over the jx-* CSS contract, with two style modes.",
  "keywords": [
    "react",
    "components",
    "ui-kit",
    "design-system",
    "brutalist",
    "framer-motion",
    "accessible"
  ],
  "license": "MIT",
  "author": "Georgiy Kataev",
  "homepage": "https://jinx-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loisakilla/Jinx-UI.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/loisakilla/Jinx-UI/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/esm-extensions.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.39.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public"
  }
}
